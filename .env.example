# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL used in emailed links (required in production), e.g. https://nextgeneducator.com
APP_URL=

# Optional: send real emails (password resets) through https://resend.com
# Without these, emails are printed to the server console in development.
RESEND_API_KEY=
EMAIL_FROM="NextGen Educator <no-reply@yourdomain.com>"

# Power admins who can open /admin (comma-separated emails)
ADMIN_EMAILS=admin@yourschool.edu
