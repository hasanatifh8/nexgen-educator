# Postgres connection string. Required on Vercel (its filesystem is read-only); leave empty locally to use data/.
# Vercel → Storage → Neon adds DATABASE_URL automatically. Use the pooled connection string.
DATABASE_URL=

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL used in emailed links (required in production), e.g. https://nextgeneducator.com
APP_URL=

# Optional: send real emails (password resets) through https://resend.com
# Without these, emails are printed to the server console in development.
RESEND_API_KEY=
EMAIL_FROM="NextGen Educator <no-reply@yourdomain.com>"

# Power admins who can open /admin (comma-separated emails)
ADMIN_EMAILS=admin@yourschool.edu

# Online payments with Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys).
# Use test keys (rzp_test_…) first; switch to live keys (rzp_live_…) when you are ready to accept real money.
# Leave empty to keep the "pay after a call" flow only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://<your-site>/api/razorpay/webhook, events payment.captured + order.paid,
# then paste the secret you chose here. Unlocks courses even if the learner closes the tab mid-payment.
RAZORPAY_WEBHOOK_SECRET=
